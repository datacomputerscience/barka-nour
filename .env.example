# Barka Nour - Single Store E-commerce
# Copy to .env.local for local dev, or set in Cloudflare Pages env

# Database - Supabase PostgreSQL (free tier)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ... # server only, never frontend
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Auth - Secure server-side
AUTH_SECRET=generate-strong-32+chars-secret # openssl rand -base64 32
AUTH_URL=http://localhost:5174

# Storage - Supabase Storage or Cloudflare R2
VITE_STORAGE_BUCKET=barka-nour-media
STORAGE_TYPE=supabase # supabase | r2 | local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Meta Integration - Server secrets never frontend
VITE_META_PIXEL_ID=123456789012345 # client safe
META_CAPI_ACCESS_TOKEN=EAA... # server only!
META_CAPI_TEST_EVENT_CODE=TEST12345 # optional for testing
META_CATALOG_ID=
META_APP_SECRET=

# Delivery Providers - Abstraction, not_configured if empty
# MesColis
MESCOLIS_API_KEY=
MESCOLIS_BASE_URL=https://api.mescolis.tn
# Aramex
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
# First Delivery
FIRST_DELIVERY_TOKEN=
# Best Delivery
BEST_DELIVERY_API_KEY=
# Navex
NAVEX_API_KEY=
# INTIGO
INTIGO_API_KEY=

# App
VITE_APP_NAME=Barka Nour
VITE_APP_URL=https://barkanour.tn
VITE_CURRENCY=TND
VITE_DEFAULT_LANGUAGE=fr
VITE_FREE_SHIPPING_THRESHOLD=150

# Cloudflare
CLOUDFLARE_PAGES=true
NODE_ENV=production

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=https://barkanour.tn
